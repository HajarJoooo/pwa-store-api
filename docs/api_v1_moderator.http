#     "rejection_reason": null,
#     "reviewed_at": "2026-11-16T16:00:00.000000Z"
#   },
#   "errors": null
# }

### ------------------------------------------------------------------------------
### 4. POST /moderator/pwas/{id}/reject - رفض التطبيق مع تسجيل السبب وتطهيره (200 OK)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/25/reject
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "reason": "يرجى توفير أيقونة ذات أبعاد 512x512 بدقة عالية، وتوضيح سياسة الخصوصية داخل التطبيق."
}

### Response: 200 OK
