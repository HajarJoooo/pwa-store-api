#       "icon_url": "https://example.com/icons/azkar.png",
#       "version": "1.2.0",
#       "rating_average": 4.85,
#       "review_count": 24,
#       "install_count": 351,
#       "category": {
#         "name": "Islamic & Lifestyle",
#         "name_ar": "إسلاميات وأسلوب حياة",
#         "slug": "islamic-lifestyle"
#       },
#       "installed_at": "2026-11-14T16:00:00.000000Z"
#     }
#   ],
#   "meta": {
#     "current_page": 1,
