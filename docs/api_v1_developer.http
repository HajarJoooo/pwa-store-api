### ------------------------------------------------------------------------------
### 4. GET /developer/pwas?status=invalid - خطأ فلترة بحالة غير صالحة (422)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas?status=deleted
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "بيانات الإدخال غير صالحة، يرجى تصحيح الأخطاء.",
#   "data": null,
#   "errors": {
#     "status": [
#       "القيمة المحددة لـ status غير صالحة."
#     ]
#   }
# }

### ------------------------------------------------------------------------------
### 5. POST /developer/pwas - تقديم تطبيق جديد للمراجعة (201 Created)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "name": "مفكرتي اليومية",
  "category_id": 1,
  "short_description": "تطبيق ويب تقدمي بسيط ومرن لكتابة اليوميات والمذكرات الشخصية",
  "description": "تطبيق كامل لحفظ اليوميات مشفرة محلياً مع دعم العمل بدون إنترنت.",
  "manifest_url": "https://diary.example.com/manifest.json",
  "start_url": "https://diary.example.com/",
  "icon_url": "https://diary.example.com/icon.png",
  "screenshots": [
    "https://diary.example.com/shot1.png"
  ],
  "version": "1.0.0"
}

### Response: 201 Created
# {
#   "success": true,
#   "message": "تم تقديم التطبيق للمراجعة بنجاح.",
