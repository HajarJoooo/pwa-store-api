### ------------------------------------------------------------------------------
### 7. POST /moderator/pwas/{id}/approve - خطأ مراجعة المشرف لتطبيقه الخاص (403)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/30/approve
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

### Response: 403 Forbidden
# {
#   "success": false,
#   "message": "لا يمكنك مراجعة أو تغيير حالة تطبيق تملكه.",
#   "data": null,
#   "errors": null
# }

### ------------------------------------------------------------------------------
### 8. GET /moderator/pwas/pending - خطأ غير مصرح (403 Forbidden - Role: developer)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas/pending
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

### Response: 403 Forbidden
# {
#   "success": false,
#   "message": "ليس لديك الصلاحية الكافية لتنفيذ هذا الإجراء.",
#   "data": null,
#   "errors": null
# }
