### ------------------------------------------------------------------------------
### 4. GET /pwas - خطأ تحقق: نوع ترتيب غير صالح (422 Unprocessable Entity)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas?sort=invalid_sort
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "البيانات المقدمة غير صالحة.",
#   "data": null,
#   "errors": {
#     "sort": [
#       "قيمة ترتيب غير صالحة."
#     ]
#   }
# }

### ------------------------------------------------------------------------------
### 5. GET /pwas - خطأ تحقق: تجاوز الحد الأقصى لعدد النتائج (per_page > 50)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas?per_page=100
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "البيانات المقدمة غير صالحة.",
#   "data": null,
#   "errors": {
#     "per_page": [
#       "يجب ألا يتجاوز عدد العناصر في الصفحة 50."
#     ]
#   }
# }

### ------------------------------------------------------------------------------
### 6. GET /pwas - خطأ تحقق: تصنيف غير موجود في قاعدة البيانات (422)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas?category=unknown-category
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "البيانات المقدمة غير صالحة.",
#   "data": null,
#   "errors": {
#     "category": [
#       "التصنيف المحدد غير موجود."
#     ]
#   }
# }

