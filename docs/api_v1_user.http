### ------------------------------------------------------------------------------
### 6. POST /pwas/{slug}/reviews - إضافة مراجعة وتقييم لتطبيق مثبت (201 Created)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/azkar-muslim-app/reviews
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "rating": 5,
  "title": "تطبيق متميز جداً",
  "content": "يعمل دون انقطاع وتصميمه مريح جداً للعين عند القراءة الليلية."
}

### Response: 201 Created
# {
#   "success": true,
#   "message": "تم إضافة تقييمك بنجاح.",
#   "data": {
#     "id": 15,
#     "rating": 5,
#     "title": "تطبيق متميز جداً",
#     "content": "يعمل دون انقطاع وتصميمه مريح جداً للعين عند القراءة الليلية.",
#     "helpful_count": 0,
#     "created_at": "2026-11-14T16:05:00.000000Z",
#     "reviewer": {
#       "first_name": "سعد",
#       "username": "saad_user",
#       "avatar_url": "https://ui-avatars.com/api/?name=Saad"
#     }
#   },
#   "errors": null
# }

### ------------------------------------------------------------------------------
### 7. POST /pwas/{slug}/reviews - خطأ تكرار المراجعة لنفس التطبيق (422)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/azkar-muslim-app/reviews
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "rating": 4,
  "title": "محاولة مراجعة ثانية"
}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
