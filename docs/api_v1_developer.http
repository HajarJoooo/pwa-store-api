### ------------------------------------------------------------------------------
### 6. POST /developer/pwas - خطأ تكرار رابط الـ Manifest للمطور (422)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "name": "تطبيق مكرر",
  "category_id": 1,
  "short_description": "وصف التطبيق",
  "manifest_url": "https://diary.example.com/manifest.json",
  "start_url": "https://diary.example.com/"
}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "بيانات الإدخال غير صالحة، يرجى تصحيح الأخطاء.",
#   "data": null,
#   "errors": {
#     "manifest_url": [
#       "لديك تطبيق مسجل بالفعل بهذا الرابط (Manifest URL)."
#     ]
#   }
# }

