### ------------------------------------------------------------------------------
### 5. POST /moderator/pwas/{id}/approve - خطأ محاولة قبول تطبيق غير معلق (422)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/24/approve
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

### Response: 422 Unprocessable Entity
# {
#   "success": false,
#   "message": "بيانات الإدخال غير صالحة، يرجى تصحيح الأخطاء.",
#   "data": null,
#   "errors": {
#     "status": [
#       "هذا التطبيق ليس قيد المراجعة حالياً."
#     ]
#   }
# }

### ------------------------------------------------------------------------------
### 6. POST /moderator/pwas/{id}/reject - خطأ سبب الرفض غير مكتمل أو مفقود (422)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/pwas/25/reject
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

{
  "reason": "قصير"
}

### Response: 422 Unprocessable Entity
