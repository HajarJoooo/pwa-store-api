### ------------------------------------------------------------------------------
### 8. GET /pwas/{slug} - محاولة جلب تطبيق غير منشور أو غير موجود (404 Not Found)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas/unpublished-or-pending-app
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

### Response: 404 Not Found
# {
#   "success": false,
#   "message": "العنصر المطلوب غير موجود.",
#   "data": null,
#   "errors": null
# }

