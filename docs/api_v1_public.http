### ==============================================================================
### PWA Store API - Phase 4: Public Endpoints (Unauthenticated)
### Base URL: http://localhost:8000/api/v1
### All responses follow ApiResponse format: { success, message, data, [meta, links], errors }
### ==============================================================================

@baseUrl = http://localhost:8000/api/v1
@acceptJson = application/json
@acceptLanguage = ar

### ------------------------------------------------------------------------------
### 1. GET /pwas - قائمة التطبيقات المنشورة الافتراضية (أحدث التطبيقات)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

### Response: 200 OK
# {
#   "success": true,
#   "message": "تم جلب البيانات بنجاح",
#   "data": [
#     {
#       "id": 1,
#       "name": "متجر أذكار المسلم",
#       "slug": "azkar-muslim-app",
#       "short_description": "تطبيق ويب تقدمي للأذكار اليومية وحصن المسلم",
#       "icon_url": "https://example.com/icons/azkar.png",
#       "version": "1.2.0",
#       "rating_average": 4.85,
#       "review_count": 24,
#       "install_count": 350,
#       "category": {
#         "id": 2,
#         "name": "Islamic & Lifestyle",
#         "name_ar": "إسلاميات وأسلوب حياة",
#         "slug": "islamic-lifestyle"
#       },
#       "created_at": "2026-11-12T18:00:00.000000Z"
#     }
#   ],
#   "meta": {
#     "current_page": 1,
#     "from": 1,
#     "last_page": 1,
#     "per_page": 12,
#     "to": 1,
#     "total": 1
#   },
#   "links": {
#     "first": "http://localhost:8000/api/v1/pwas?page=1",
#     "last": "http://localhost:8000/api/v1/pwas?page=1",
#     "prev": null,
#     "next": null
#   },
#   "errors": null
# }

### ------------------------------------------------------------------------------
### 2. GET /pwas - البحث بالكلمات والرموز مع التهريب (Search with Wildcards)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/pwas?search=أذكار
Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}

