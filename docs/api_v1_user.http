Accept: {{acceptJson}}
Accept-Language: {{acceptLanguage}}
Authorization: Bearer {{authToken}}

### Response: 200 OK
# {
#   "success": true,
#   "message": "تم حذف التقييم بنجاح.",
#   "data": null,
#   "errors": null
# }

